# ---- Anthropic (server-only, never expose to the browser) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-only, for sync jobs

# ---- QuickBooks (Phase 2) ----
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://yourdomain.com/api/integrations/quickbooks/callback
QBO_ENVIRONMENT=sandbox                  # sandbox | production

# ---- Plaid (Phase 3) ----
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                        # sandbox | production

# ---- Optional data feeds ----
FRED_API_KEY=                            # free at fred.stlouisfed.org
